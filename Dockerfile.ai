FROM python:3.12-slim
WORKDIR /srv
COPY requirements*.txt .
RUN pip install --no-cache-dir torch==2.7.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ai.txt
COPY app ./app
RUN useradd --create-home library && mkdir -p /home/library/models && chown library:library /home/library/models
USER library
CMD ["uvicorn", "app.recommendations:app", "--host", "0.0.0.0", "--port", "8000"]
